       "settings": {
        "html": "<!-- King Solomon Project — scroll-tied video scene. Paste as-is into one Elementor HTML widget (page layout: Elementor Canvas). -->\n<link href=\"https://db.onlinewebfonts.com/c/95cecf452d3208890088a5b4c19c7ecf?family=Helvetica+Neue+ME\" rel=\"stylesheet\">\n<style>\n/* King Solomon Project — every rule is scoped to #ksp except the three page-level\n   rules the spec puts on html/body; this CSS only ever loads on this one page.\n   Values are Tailwind 3 defaults written in px so the theme's root font-size can't shift them. */\nhtml { scroll-behavior: smooth; }\nbody { margin: 0; overflow-x: hidden; }\n/* The site's Customizer CSS sets `html, body { overflow-x: hidden }`; with both hidden, body\n   becomes a scroll container and position:sticky stops working. `clip` crops the same way\n   without creating a scroll container (older browsers without clip fall back to visible).\n   !important because theme rules with higher specificity also hide body overflow. */\nhtml, body { overflow-x: clip !important; }\n@supports not (overflow-x: clip) { html, body { overflow-x: visible !important; } }\n\n/* scoped preflight (Tailwind 3), beats theme/kit element rules by id specificity */\n#ksp, #ksp *, #ksp *::before, #ksp *::after { box-sizing: border-box; border: 0 solid #e5e7eb; margin: 0; padding: 0; }\n#ksp {\n  position: relative; display: block; width: 100%;\n  font-family: 'Helvetica Neue ME', 'Helvetica Neue', Helvetica, Arial, sans-serif;\n  font-size: 16px; font-weight: 400; font-style: normal; line-height: 1.5; letter-spacing: normal;\n  color: #000; text-align: start; text-transform: none; -webkit-text-size-adjust: 100%; tab-size: 4;\n  overflow-wrap: normal; word-break: normal; white-space: normal; word-spacing: normal;\n  -webkit-tap-highlight-color: rgba(0, 0, 0, 0.18);\n}\n#ksp h1, #ksp h2, #ksp p, #ksp span, #ksp div, #ksp nav, #ksp section {\n  font-family: inherit; font-size: inherit; font-weight: inherit; line-height: inherit;\n  letter-spacing: inherit; text-transform: inherit; color: inherit; background: none; box-shadow: none;\n}\n#ksp a {\n  font-family: inherit; font-size: inherit; font-weight: inherit; line-height: inherit; letter-spacing: inherit; text-transform: inherit;\n  color: inherit; text-decoration: inherit; background: none; box-shadow: none; transition: none; }\n#ksp button {\n  font-family: inherit; font-size: 100%; font-weight: inherit; line-height: inherit; letter-spacing: inherit;\n  color: inherit; text-transform: none; background-color: transparent; background-image: none;\n  box-shadow: none; border-radius: 0; min-height: 0; width: auto; height: auto; text-shadow: none;\n  -webkit-appearance: button; appearance: button; cursor: pointer;\n}\n#ksp svg { display: block; vertical-align: middle; }\n#ksp video, #ksp canvas { display: block; max-width: 100%; height: auto; line-height: inherit; }\n\n/* Hebrew page: keep the site's own font as configured in WordPress/Elementor (inherited from body). */\n#ksp[lang=\"he\"] { font-family: inherit; }\n\n/* scene */\n#ksp .k-track { position: relative; height: 500vh; }\n#ksp .k-sticky { position: sticky; top: 0; width: 100%; height: 100vh; overflow: hidden; }\n#ksp .k-media { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; }\n#ksp .k-canvas { opacity: 0; transition: opacity 300ms cubic-bezier(0.4, 0, 0.2, 1); }\n#ksp .k-canvas.is-live { opacity: 1; }\n#ksp .k-overlay { position: absolute; inset: 0; pointer-events: none; }\n\n/* navbar */\n#ksp .k-nav {\n  position: absolute; top: 0; left: 0; right: 0; z-index: 50; pointer-events: auto;\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 32px 24px 24px; color: #1D3045;\n  transition: color, background-color, border-color, text-decoration-color, fill, stroke;\n  transition-duration: 500ms; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\n#ksp.is-dark .k-nav { color: #fff; }\n#ksp .k-ent {\n  opacity: 0; transform: translateY(-12px);\n  transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--d), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1) var(--d);\n}\n#ksp.is-mounted .k-ent { opacity: 1; transform: translateY(0); }\n#ksp .k-links { display: none; align-items: center; gap: 32px; }\n#ksp .k-links .k-ent { display: flex; }\n#ksp .k-link { position: relative; font-size: 12px; line-height: 16px; letter-spacing: 0.15em; text-transform: uppercase; font-weight: 500; }\n#ksp .k-link:hover { opacity: 0.7; }\n#ksp .k-underline { position: absolute; left: 0; bottom: -12px; width: 100%; height: 2px; background-color: currentColor; }\n#ksp .k-burger { display: flex; flex-direction: column; gap: 5px; }\n#ksp .k-bar { display: block; width: 24px; height: 2px; background-color: currentColor; }\n#ksp .k-bar.k-bar-s { width: 16px; }\n#ksp .k-right { display: none; align-items: center; gap: 32px; }\n#ksp .k-type { font-size: 12px; line-height: 16px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 500; }\n#ksp .k-news { display: flex; align-items: center; gap: 8px; }\n#ksp .k-dot { width: 20px; height: 20px; border-radius: 9999px; background-color: currentColor; display: flex; align-items: center; justify-content: center; }\n#ksp .k-dot svg {\n  color: #fff; stroke: currentColor;\n  transition: color, background-color, border-color, text-decoration-color, fill, stroke;\n  transition-duration: 500ms; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n}\n#ksp.is-dark .k-dot svg { color: #1D3045; }\n#ksp .k-menu-label { display: none; }\n\n/* sections */\n#ksp .k-s { position: absolute; inset: 0; transition: opacity 0.1s ease-out; }\n#ksp .k-st {\n  opacity: 0; transform: translateY(24px);\n  transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) var(--d), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) var(--d);\n}\n#ksp .k-s.is-visible .k-st { opacity: 1; transform: translateY(0); }\n#ksp .k-s.is-visible .k-pe { pointer-events: auto; }\n#ksp .k-circle { border-radius: 9999px; border-width: 1px; border-style: solid; display: flex; align-items: center; justify-content: center; }\n#ksp .k-c48 { width: 48px; height: 48px; }\n#ksp .k-c40 { width: 40px; height: 40px; }\n#ksp[dir=\"rtl\"] .k-flip svg { transform: scaleX(-1); }\n\n#ksp .k-s1 { display: flex; flex-direction: column; justify-content: center; padding: 0 24px; }\n#ksp .k-h1 { font-weight: 300; text-transform: uppercase; line-height: 1.2; font-size: clamp(32px, 5vw, 80px); color: #1D3045; }\n#ksp .k-sub { margin-top: 24px; font-size: 14px; line-height: 20px; letter-spacing: 0.3em; text-transform: uppercase; color: #1D304590; }\n#ksp .k-s1-btn { position: absolute; bottom: 48px; inset-inline-end: 24px; }\n#ksp .k-next { border-color: #1D304550; color: #1D3045; }\n#ksp .k-next:hover { opacity: 0.7; }\n\n#ksp .k-s2 { display: flex; align-items: center; justify-content: center; padding: 0 24px; }\n#ksp .k-s2-inner { max-width: 900px; }\n#ksp .k-h2a {\n  font-weight: 200; letter-spacing: 0.025em; line-height: 1.3; text-align: center; text-transform: uppercase;\n  font-size: clamp(24px, 4.5vw, 72px); color: #1D3045;\n}\n#ksp .k-h2a .k-a80 { color: #1D304580; }\n#ksp .k-h2a .k-a50 { color: #1D304550; }\n#ksp .k-rail { position: absolute; bottom: 64px; inset-inline-end: 24px; display: flex; flex-direction: column; align-items: center; gap: 16px; }\n#ksp .k-down { border-color: #1D304540; color: #1D3045; }\n#ksp .k-dots { margin-top: 16px; display: flex; flex-direction: column; align-items: center; gap: 8px; }\n#ksp .k-dots span { display: block; border-radius: 9999px; width: 6px; height: 6px; background-color: #1D304540; }\n#ksp .k-dots span.is-active { width: 8px; height: 8px; background-color: #1D3045; }\n#ksp .k-up { margin-top: 8px; border-color: #1D304530; color: #1D304580; }\n\n#ksp .k-s3 { display: flex; align-items: center; justify-content: flex-end; padding: 0 24px; }\n#ksp .k-s3-inner { max-width: 672px; text-align: start; }\n#ksp .k-eyebrow { color: rgb(255 255 255 / 0.6); font-size: 18px; line-height: 28px; letter-spacing: 0.025em; margin-bottom: 16px; }\n#ksp .k-h2b {\n  font-weight: 300; color: #fff; line-height: 1.2; text-transform: uppercase; letter-spacing: 0.025em;\n  margin-bottom: 32px; font-size: clamp(32px, 4vw, 64px);\n}\n#ksp .k-cta { display: flex; align-items: center; gap: 16px; }\n#ksp .k-cta-label { font-size: 14px; line-height: 20px; letter-spacing: 0.3em; color: rgb(255 255 255 / 0.8); text-transform: uppercase; }\n#ksp .k-cta-btn {\n  width: 40px; height: 40px; border-radius: 9999px; background-color: #fff; color: #1f2937;\n  display: flex; align-items: center; justify-content: center;\n  transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n#ksp .k-cta-btn:hover { transform: scale(1.1); }\n\n/* mobile menu overlay */\n#ksp .k-menu {\n  position: fixed; inset: 0; z-index: 100; background-color: #1D3045; opacity: 0; visibility: hidden;\n  transition: all 500ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n#ksp .k-menu.is-open { opacity: 1; visibility: visible; }\n#ksp .k-panel { height: 100%; display: flex; flex-direction: column; transform: translateY(-32px); transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1); }\n#ksp .k-menu.is-open .k-panel { transform: translateY(0); }\n#ksp .k-close-row { display: flex; justify-content: flex-end; padding: 32px 24px 0; }\n#ksp .k-close { border-color: rgb(255 255 255 / 0.3); color: #fff; }\n#ksp .k-close:hover { border-color: #fff; }\n#ksp .k-mlinks { flex: 1 1 0%; display: flex; flex-direction: column; justify-content: center; padding: 0 32px; }\n#ksp .k-mlink {\n  padding: 12px 0; font-size: 24px; line-height: 32px; font-weight: 300; letter-spacing: 0.025em; text-transform: uppercase;\n  opacity: 0; transform: translateY(20px);\n  transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1) var(--d), transform 0.5s cubic-bezier(0.4, 0, 0.2, 1) var(--d);\n}\n#ksp .k-mlink { color: rgb(255 255 255 / 0.6); }\n#ksp .k-mlink:hover, #ksp .k-mlink.is-active { color: #fff; }\n#ksp .k-menu.is-open .k-mlink { opacity: 1; transform: translateY(0); }\n#ksp .k-mfoot { padding: 0 32px 40px; display: flex; align-items: center; gap: 32px; font-size: 12px; line-height: 16px; letter-spacing: 0.2em; text-transform: uppercase; color: rgb(255 255 255 / 0.6); }\n\n@media (min-width: 640px) {\n  #ksp .k-nav { padding: 48px 32px 24px; }\n  #ksp .k-right { display: flex; }\n  #ksp .k-s1, #ksp .k-s2, #ksp .k-s3 { padding: 0 32px; }\n  #ksp .k-s1-btn, #ksp .k-rail { inset-inline-end: 32px; }\n  #ksp .k-close-row { padding: 48px 32px 0; }\n  #ksp .k-mlinks { padding: 0 48px; }\n  #ksp .k-mlink { font-size: 30px; line-height: 36px; }\n  #ksp .k-mfoot { padding: 0 48px 40px; }\n}\n@media (min-width: 768px) {\n  #ksp .k-nav { padding-left: 48px; padding-right: 48px; }\n  #ksp .k-s1, #ksp .k-s3 { padding: 0 80px; }\n  #ksp .k-s1-btn, #ksp .k-rail { inset-inline-end: 48px; }\n}\n@media (min-width: 1024px) {\n  #ksp .k-links { display: flex; }\n  #ksp .k-burger, #ksp .k-menu-btn { display: none; }\n  #ksp .k-menu-label { display: inline; }\n  #ksp .k-s1, #ksp .k-s3 { padding: 0 128px; }\n}\n@media (min-width: 1280px) {\n  #ksp .k-links { gap: 40px; }\n}\n</style>\n<div id=\"ksp\" lang=\"en\" dir=\"ltr\">\n<div class=\"k-track\" data-k=\"track\">\n<div class=\"k-sticky\">\n<video class=\"k-media\" data-k=\"video\" src=\"https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/hf_20260821_114821_a8ca298f-be2c-4613-a4dd-51b69e16bbde.mp4\" muted playsinline preload=\"auto\"></video>\n<canvas class=\"k-media k-canvas\" data-k=\"canvas\" width=\"1920\" height=\"1080\"></canvas>\n<div class=\"k-overlay\">\n<nav class=\"k-nav\">\n<div class=\"k-links\"><div class=\"k-ent\" style=\"--d:100ms\"><a href=\"#\" class=\"k-link\">VECTRUS ENERGY<span class=\"k-underline\"></span></a></div><div class=\"k-ent\" style=\"--d:180ms\"><a href=\"#\" class=\"k-link\">VECTRUS UPSTREAM</a></div><div class=\"k-ent\" style=\"--d:260ms\"><a href=\"#\" class=\"k-link\">VECTRUS MARKETS</a></div><div class=\"k-ent\" style=\"--d:340ms\"><a href=\"#\" class=\"k-link\">VECTRUS SYSTEMS</a></div><div class=\"k-ent\" style=\"--d:420ms\"><a href=\"#\" class=\"k-link\">VECTRUS+</a></div></div>\n<button type=\"button\" class=\"k-burger\" data-k=\"menu-open\" aria-label=\"Open menu\"><span class=\"k-bar\"></span><span class=\"k-bar\"></span><span class=\"k-bar k-bar-s\"></span></button>\n<div class=\"k-right k-ent\" style=\"--d:500ms\"><a href=\"#\" class=\"k-news k-type\">News<span class=\"k-dot\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 16v-4\"></path><path d=\"M12 8h.01\"></path></svg></span></a><span class=\"k-menu-label k-type\">Menu</span><button type=\"button\" class=\"k-menu-btn k-type\" data-k=\"menu-open\">Menu</button></div>\n</nav>\n<section class=\"k-s k-s1\" data-k=\"s1\">\n<div class=\"k-st\" style=\"--d:0ms\"><h1 class=\"k-h1\">Advancing resources for a cleaner future</h1></div>\n<div class=\"k-st\" style=\"--d:150ms\"><p class=\"k-sub\">Sustainable power with purpose</p></div>\n<div class=\"k-st k-s1-btn\" style=\"--d:300ms\"><button type=\"button\" class=\"k-circle k-c48 k-next k-pe k-flip\" aria-label=\"Next\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></div>\n</section>\n<section class=\"k-s k-s2\" data-k=\"s2\">\n<div class=\"k-s2-inner\"><div class=\"k-st\" style=\"--d:0ms\"><h2 class=\"k-h2a\">We build lasting partnerships with vision <span class=\"k-a80\">and precision</span> <span class=\"k-a50\">across every frontier</span></h2></div></div>\n<div class=\"k-rail\">\n<div class=\"k-st\" style=\"--d:200ms\"><button type=\"button\" class=\"k-circle k-c48 k-down k-pe\" aria-label=\"Scroll down\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 5v14\"></path><path d=\"m19 12-7 7-7-7\"></path></svg></button></div>\n<div class=\"k-st\" style=\"--d:350ms\"><div class=\"k-dots\"><span class=\"is-active\"></span><span></span><span></span></div></div>\n<div class=\"k-st\" style=\"--d:500ms\"><button type=\"button\" class=\"k-circle k-c40 k-up k-pe\" aria-label=\"Scroll up\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m18 15-6-6-6 6\"></path></svg></button></div>\n</div>\n</section>\n<section class=\"k-s k-s3\" data-k=\"s3\">\n<div class=\"k-s3-inner\">\n<div class=\"k-st\" style=\"--d:0ms\"><p class=\"k-eyebrow\">Halder | Nordvik</p></div>\n<div class=\"k-st\" style=\"--d:150ms\"><h2 class=\"k-h2b\">Fueling ambition,<br>shaping tomorrow.</h2></div>\n<div class=\"k-st\" style=\"--d:300ms\"><div class=\"k-cta\"><span class=\"k-cta-label\">Contact Nordvik</span><button type=\"button\" class=\"k-cta-btn k-pe k-flip\" aria-label=\"Contact Nordvik\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></div></div>\n</div>\n</section>\n</div>\n</div>\n</div>\n<div class=\"k-menu\" data-k=\"menu\" aria-hidden=\"true\">\n<div class=\"k-panel\">\n<div class=\"k-close-row\"><button type=\"button\" class=\"k-circle k-c40 k-close\" dat